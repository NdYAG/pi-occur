{
	"name": "pi-occur",
	"version": "0.1.0",
	"description": "Emacs occur for the pi transcript: list matching paragraphs, jump to one",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "node --test test/*.test.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"@types/node": "22.19.19",
		"typescript": "5.9.3"
	}
}
