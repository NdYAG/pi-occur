{
	"name": "pi-occur",
	"version": "0.1.1",
	"description": "Emacs occur for the pi transcript: list matching paragraphs, jump to one",
	"keywords": [
		"pi-package",
		"pi-extension",
		"occur",
		"search"
	],
	"license": "MIT",
	"type": "module",
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"image": "https://ndyag.github.io/pi-occur/screenshot.png"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "node --test test/*.test.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"@types/node": "22.19.19",
		"typescript": "5.9.3"
	}
}
